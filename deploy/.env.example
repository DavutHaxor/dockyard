# Copy to .env and fill in the values. `.env` is git-ignored.

# Generate with: openssl rand -hex 32
DOCKYARD_ADMIN_TOKEN=

# Interface/port for the published API. Keep loopback until TLS is set up.
DOCKYARD_BIND=127.0.0.1
DOCKYARD_PORT=8080

# Group that owns the Docker socket:
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# How often metrics are sampled and pushed over WebSocket.
DOCKYARD_METRICS_INTERVAL=2s

# Only needed for browser clients (Flutter web), comma-separated.
# DOCKYARD_ALLOWED_ORIGINS=http://localhost:3000
